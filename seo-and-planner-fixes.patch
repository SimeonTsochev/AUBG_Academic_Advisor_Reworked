+import { describe, expect, it } from "vitest";
+import { NO_PROGRAM_LINK, readProgramLink } from "./programLink";
+
+const MAJORS = ["Computer Science", "Economics", "Mathematics"];
+const MINORS = ["Computer Science", "Finance", "Economics"];
+
+describe("readProgramLink", () => {
+  it("returns the shared empty link when nothing is requested", () => {
+    expect(readProgramLink("", MAJORS, MINORS)).toBe(NO_PROGRAM_LINK);
+    expect(readProgramLink("?utm_source=x", MAJORS, MINORS)).toBe(NO_PROGRAM_LINK);
+  });
+
+  it("matches encoded names case-insensitively and returns the catalog spelling", () => {
+    expect(readProgramLink("?major=computer%20science&minor=FINANCE", MAJORS, MINORS)).toEqual({
+      majors: ["Computer Science"],
+      minors: ["Finance"],
+    });
+  });
+
+  it("ignores programs the catalog does not offer", () => {
+    expect(readProgramLink("?major=Alchemy", MAJORS, MINORS)).toBe(NO_PROGRAM_LINK);
+  });
+
+  it("drops a minor that is already a linked major", () => {
+    expect(readProgramLink("?major=Economics&minor=Economics", MAJORS, MINORS)).toEqual({
+      majors: ["Economics"],
+      minors: [],
+    });
+  });
+
+  it("keeps at most two programs of each type, without duplicates", () => {
+    const link = readProgramLink(
+      "?major=Economics&major=Economics&major=Mathematics&major=Computer%20Science",
+      MAJORS,
+      MINORS,
+    );
+    expect(link.majors).toEqual(["Economics", "Mathematics"]);
+  });
+});
diff --git a/frontend/src/utils/programLink.ts b/frontend/src/utils/programLink.ts
new file mode 100644
index 0000000..91a4ab9
--- /dev/null
+++ b/frontend/src/utils/programLink.ts
@@ -0,0 +1,34 @@
+/** Programs named by a requirement-page link such as `/?major=Computer%20Science&minor=Finance`. */
+export interface ProgramLink {
+  majors: string[];
+  minors: string[];
+}
+
+export const NO_PROGRAM_LINK: ProgramLink = { majors: [], minors: [] };
+
+const MAX_PROGRAMS_PER_TYPE = 2;
+
+function matchPrograms(requested: string[], available: string[]): string[] {
+  const byKey = new Map(available.map((name) => [name.trim().toLowerCase(), name]));
+  const matched: string[] = [];
+  for (const raw of requested) {
+    const name = byKey.get(raw.trim().toLowerCase());
+    if (name && !matched.includes(name)) matched.push(name);
+  }
+  return matched.slice(0, MAX_PROGRAMS_PER_TYPE);
+}
+
+/**
+ * Reads `major` / `minor` query parameters and keeps only names the catalog offers.
+ * A program cannot be both: a minor that is also a selected major is dropped.
+ */
+export function readProgramLink(search: string, majors: string[], minors: string[]): ProgramLink {
+  const params = new URLSearchParams(search);
+  const linkedMajors = matchPrograms(params.getAll("major"), majors);
+  const linkedMinors = matchPrograms(
+    params.getAll("minor"),
+    minors.filter((name) => !linkedMajors.includes(name)),
+  );
+  if (!linkedMajors.length && !linkedMinors.length) return NO_PROGRAM_LINK;
+  return { majors: linkedMajors, minors: linkedMinors };
+}
