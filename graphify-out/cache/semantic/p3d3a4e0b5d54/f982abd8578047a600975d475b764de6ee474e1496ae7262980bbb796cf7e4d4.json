{"nodes": [{"id": "claude", "label": "CLAUDE.md (repo guide)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_aubg_academic_advisor", "label": "AUBG Academic Advisor", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FastAPI backend builds a multi-semester degree plan from the AUBG catalog; Vite+React+TS frontend (exported from Figma) lets a student pick majors/minors, import a transcript and edit the plan."}, {"id": "claude_catalog_data_pipeline", "label": "Catalog data pipeline (offline build -> runtime JSON)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PDF and Excel are parsed only at build time into compact JSON artifacts in backend/data; runtime never parses the PDF or Excel, it loads the artifacts once via getCatalogCache()."}, {"id": "claude_catalog_sources", "label": "Catalog sources: AY-2026-27-2nd-ed.pdf and course_catalog 110926.xls", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Excel export's headers are shifted (tags sit under 'Fee'), so _resolve_area_column picks the tag column by contents."}, {"id": "claude_policy_overrides", "label": "policy_overrides.json (hand-edited catalog corrections)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrong catalog facts (credits, prereqs, coreqs, degree total, program courses) are fixed here, never in engine code; policy credits win over Excel and PDF values."}, {"id": "claude_course_renumbering", "label": "course_renumbering (old code -> current code)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "generate_plan translates completed/in-progress/retake codes so a transcript with an old number (COS 4060 -> COS 3060) satisfies the new requirement."}, {"id": "claude_course_groups", "label": "course_groups ({\"group\": name} expansion)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A course list repeated across rules is named once and expanded by catalog_artifacts.expand_course_groups when the policy loads; unknown names fail loudly."}, {"id": "claude_program_options", "label": "Program options (concentrations, language focus; block roles elective/required/collateral)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choices keyed by program name; collateral blocks sit outside program credits, are not double-counted and not in GPA-in-major; a required option without a choice is a validation error."}, {"id": "claude_elective_rules", "label": "Elective sub-rules (at_least / at_most / at_least_in_one_group over CourseSets)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parsed into ElectiveRule/CourseSet; caps limit what counts, unmet minimums raise remaining; elective_pool, elective_excluded, elective_pool_only, max_transfer_elective_credits (18)."}, {"id": "claude_placement_waivers", "label": "Placement waivers (COS 1020, INF 1030, MLC; MAT 1000 / ENG 1000 auto-waiver)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A waived course satisfies its requirement with no credits; replace_with_elective adds its credits to electives. Foundation courses are waived automatically when the student moved past them (_foundation_courses_moved_past)."}, {"id": "claude_grade_and_sequence_rules", "label": "grade_rules and sequence_rules (SequenceRule)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "program_sequence_rules parses them into SequenceRules which the scheduler (_eligible_for_term) plans by and graduation_checks.sequence_check audits."}, {"id": "claude_program_choice_block_convention", "label": "'Program Choice' block convention (count in rule_text, empty courses_required)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Otherwise minor-proximity counts it twice and the OR-detection splits it."}, {"id": "claude_catalog_dict_shape", "label": "Catalog dict shape (courses, course_meta, majors/minors, gen_ed, degree_total_credits)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L145", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The contract every engine function consumes and tests build by hand."}, {"id": "claude_plan_generation_flow", "label": "generate_plan flow (slots -> select -> schedule -> balance -> overrides -> validate -> audit)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "generate_plan is the single entry point of degree_engine.py."}, {"id": "claude_requirement_slots", "label": "Requirement slots (fixed / choice)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L149", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "select_courses_for_slots prefers courses satisfying several slots and adds prerequisites."}, {"id": "claude_term_scheduling", "label": "Term scheduling and balancing (FREE ELECTIVE placeholders, registered_terms_full)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A term with in-progress courses is already registered and is treated as full; _rebalance_term_mix never moves foundation courses or co-requisite pairs."}, {"id": "claude_plan_overrides", "label": "Plan overrides (add/remove/move by instance_id, OVERRIDE_* warnings)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overrides are saved against an older plan, so they follow the plan when it changes (OVERRIDE_REMOVE_RELOCATED, OVERRIDE_TERM_BEFORE_START); they warn instead of failing; remove wins on conflict."}, {"id": "claude_relieve_overloaded_terms", "label": "Overloaded-term relief (OVERRIDE_COURSE_RELIEVED)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog corrections keep changing the base plan and saved swaps must survive; only the planner's own courses are moved, never student edits, foundation courses or co-requisite pairs."}, {"id": "claude_plan_state_audit", "label": "PlanState + audit_plan (graduation checks, elective progress, GPA record)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New policy checks take the state rather than more parameters."}, {"id": "claude_graduation_rules", "label": "Graduation rules (3 WICs, 60 AUBG credits, 3 retakes, double-counting limits, internships, independent studies)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catalog rules the requirement slots cannot express; added to validation_errors."}, {"id": "claude_dual_diploma_rule", "label": "Dual-diploma rule (DiplomaNote, p.72)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only reported as graduation_checks.dual_diploma.ok and shown as a note, because a student may not have added the second major yet."}, {"id": "claude_enforce_academic_policies", "label": "enforce_academic_policies flag", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Residency, course-load and independent-study rules apply only when the catalog sets it; policy_overrides.json does, synthetic test catalogs don't."}, {"id": "claude_academic_record", "label": "Academic record (GPA, Dean's/President's List, Latin honors, load limits 17/19/22)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grades arrive with each request ([{code, grade, term}], latest attempt wins)."}, {"id": "claude_credit_load_constants", "label": "Credit constants: MIN_CREDITS_PER_TERM 12 vs PLANNING_MIN 14, STANDARD_MAX 17", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep 12 (error threshold) and 14 (planner fill) apart: changing the fill level reshuffles every base plan and breaks saved edits. API always plans at 17 and ignores max_credits_per_semester."}, {"id": "claude_standing_rules", "label": "Class standing by earned credits (27/57/87)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L156", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Earned credits include transfer credits and completed courses outside the planning pool, minus placement waivers."}, {"id": "claude_term_availability", "label": "Term availability (semester_availability, OVERRIDE_ADD_TERM_UNAVAILABLE)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A course is 'not offered' only if the term has published data and omits it; other terms are unknown and allowed. Frontend blocks the same terms so dialogs never offer a term the planner refuses."}, {"id": "claude_max_plan_terms", "label": "MAX_PLAN_TERMS = 12 (never silently truncated)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L158", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_program_special_cases", "label": "Hard-coded program special cases (CS, Creative Writing, Fine Arts, Economics minors, Textual Analysis)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search for the program name before changing generic logic."}, {"id": "claude_term_labels", "label": "Canonical term labels 'Fall YYYY' / 'Spring YYYY'", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_api_routes", "label": "API routes (/catalog/load-default, /plan/generate, /transcript/import, /program-snapshots, ...)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "models.py is mirrored by hand in frontend/src/api.ts; change both together."}, {"id": "claude_plan_cache", "label": "PLAN_CACHE (locked memo keyed by request JSON + current term)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan endpoints are plain def (threadpool) because planning is CPU-bound."}, {"id": "claude_backend_source_of_truth", "label": "Backend is the source of truth for plan contents", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every edit re-calls /plan/generate with accumulated overrides; semester cards show semester_plan as returned with no client-side re-picking, padding or trimming."}, {"id": "claude_frontend_screen_flow", "label": "Frontend screen flow (welcome -> setup -> advisor, SetupPrefill)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_private_grades", "label": "Private grades (localStorage per share token, never in snapshot)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grades are kept out of the snapshot payload so a shared /p/<token> link does not reveal them; the backend never stores grades."}, {"id": "claude_shared_snapshot_links", "label": "Shared /p/<token> snapshot links (Supabase, debounced autosave)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L91", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No test covers the snapshot endpoints; add one before changing them."}, {"id": "claude_frontend_utils_convention", "label": "Pure unit-tested helpers in src/utils, state in src/hooks", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L169", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MainAdvisorScreen.tsx is very large; new logic goes in utils rather than the component."}, {"id": "claude_seo_program_pages", "label": "Public requirement pages (SEO: programs.json -> static HTML, sitemap)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L171", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from the planner's own requirement slots; test_program_pages fails when the committed file is stale; Self-Designed Major skipped (_SKIP_PROGRAMS); vercel.json only rewrites /p/:token so unknown URLs are real 404s."}, {"id": "claude_vercel_deployment", "label": "Vercel deployment (frontend aubg-advisor.com, backend *.vercel.app, two vercel.json copies)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L174", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend installed with uv from requirements.txt; unpinned transitive deps (multidict via supabase) can break builds when upstream publishes partially."}, {"id": "claude_cors_policy", "label": "CORS policy (localhost, *.vercel.app, CORS_ORIGINS, CORS_ALLOW_ALL)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L176", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Env vars are read at import, so changing one needs a backend redeploy."}, {"id": "claude_check_script", "label": "scripts/check.py (CI + pre-push: lint, tests, typecheck, build)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exits early without npm on PATH; prepend Node to PATH rather than skipping the hook."}, {"id": "claude_python_312_requirement", "label": "Python 3.12 requirement", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The pinned pydantic==2.11.7 has no wheel for Python 3.14."}, {"id": "claude_vite_plugin_react_choice", "label": "@vitejs/plugin-react instead of SWC", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows Application Control on the dev machine blocks the unsigned @swc/core binary."}, {"id": "claude_isolated_test_case", "label": "IsolatedTestCase (excel_index empty/real)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L182", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "excel_course_catalog keeps a module-global course index; each test starts from a known index and restores the previous state."}, {"id": "claude_current_start_term_clamp", "label": "Start-term clamp (_current_start_term uses date.today())", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests patch degree_engine._current_start_term when term labels matter."}, {"id": "claude_real_catalog_scenarios", "label": "Real-catalog scenario tests (every major at several stages)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "L186", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add a scenario whenever a planning bug is fixed."}], "edges": [{"source": "claude", "target": "claude_aubg_academic_advisor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_f