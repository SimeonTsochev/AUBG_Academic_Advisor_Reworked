{"nodes": [{"id": "_agents_skills_browser_mcp_agent_skill_browser_mcp_agent", "label": "Browser MCP Agent skill (.agents)", "file_type": "document", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets an agent drive a real fingerprinted browser over MCP tool calls without writing Playwright code; used in this repo for browser UX QA."}, {"id": "_agents_skills_browser_mcp_agent_skill_anti_detect_browser_package", "label": "anti-detect-browser npm package (MCP server)", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_browser_mcp_agent_skill_antibrow_pypi_package", "label": "antibrow PyPI package", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_browser_mcp_agent_skill_kernel_level_fingerprint", "label": "Kernel-level real-device fingerprint", "file_type": "rationale", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spoofing inside the Chromium kernel keeps Canvas/WebGL/audio/fonts/timezone and TLS coherent, unlike patched headless browsers; not a guaranteed pass against enterprise bot managers."}, {"id": "_agents_skills_browser_mcp_agent_skill_persistent_profile", "label": "Persistent browser profile", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_browser_mcp_agent_skill_temporary_profile", "label": "Temporary (throwaway) profile option", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps untrusted agent browsing out of logged-in profiles; temp profiles are never swept automatically."}, {"id": "_agents_skills_browser_mcp_agent_skill_supply_chain_pinning", "label": "Supply chain pinning (exact versions, no npx latest)", "file_type": "rationale", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "npx re-resolves the package on every launch; installing a reviewed version pins code. The browser kernel is a closed-source binary from a small vendor and phones home for licensing."}, {"id": "_agents_skills_browser_mcp_agent_skill_browsing_tool_set", "label": "Browsing tool set (launch_browser, navigate, get_content, screenshot, click, fill, close_browser)", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expose only what a task needs; evaluate, live view and profile/proxy tools widen what a hijacked agent can reach."}, {"id": "_agents_skills_browser_mcp_agent_skill_recipe_tools", "label": "Recipe tools (list_recipes, run_recipe, fanout_recipe)", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_agents_skills_browser_mcp_agent_skill_untrusted_browser_input", "label": "Everything the browser returns is untrusted input", "file_type": "rationale", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L150", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent both reads pages and picks next tool call, the condition for indirect prompt injection: page text is data, URLs come from the operator, secrets never enter the browser, writes need human confirmation."}, {"id": "_agents_skills_browser_mcp_agent_skill_concurrency_limit", "label": "Kernel-enforced concurrency limit (close_browser required)", "file_type": "concept", "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free plan allows 1 concurrent browser via cross-process file locks; a forgotten close_browser blocks the next launch."}], "edges": [{"source": "_agents_skills_browser_mcp_agent_skill_browser_mcp_agent", "target": "_agents_skills_browser_mcp_agent_skill_anti_detect_browser_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L11", "weight": 1.0}, {"source": "_agents_skills_browser_mcp_agent_skill_browser_mcp_agent", "target": "_agents_skills_browser_mcp_agent_skill_antibrow_pypi_package", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L12", "weight": 1.0}, {"source": "_agents_skills_browser_mcp_agent_skill_antibrow_pypi_package", "target": "_agents_skills_browser_mcp_agent_skill_anti_detect_browser_package", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L95", "weight": 1.0}, {"source": "_agents_skills_browser_mcp_agent_skill_kernel_level_fingerprint", "target": "_agents_skills_browser_mcp_agent_skill_browser_mcp_agent", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".agents/skills/browser-mcp-agent/SKILL.md", "source_location": "L22", "weight